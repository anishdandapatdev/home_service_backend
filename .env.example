PORT=3000
NODE_ENV=development

# Database & Redis
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/home_maintenance_db?schema=public
REDIS_URL=redis://localhost:6379

# JWT Config
JWT_ACCESS_SECRET=super-secret-access-key-home-maintenance-2026
JWT_REFRESH_SECRET=super-secret-refresh-key-home-maintenance-2026
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_dummy_key_id
RAZORPAY_KEY_SECRET=rzp_test_dummy_key_secret
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_dummy

# 2Factor.in SMS Gateway (Dedicated Indian OTP ~₹0.165/OTP)
TWOFACTOR_API_KEY=your_2factor_api_key_here

# Fast2SMS Gateway (Quick OTP route)
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# MSG91 SMS Gateway
MSG91_API_KEY=msg91_dummy_api_key
MSG91_SENDER_ID=HOMEMNT

# S3 / Object Storage
S3_ACCESS_KEY=dummy_s3_access_key
S3_SECRET_KEY=dummy_s3_secret_key
S3_BUCKET=home-maintenance-assets
S3_REGION=ap-south-1

# Push Notifications
FCM_SERVER_KEY=dummy_fcm_key
APNS_KEY_ID=dummy_apns_key_id
APNS_TEAM_ID=dummy_apns_team_id
APNS_PRIVATE_KEY=dummy_apns_private_key

CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
